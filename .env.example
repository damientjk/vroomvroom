# Copy to .env and fill in. Never commit .env.
ADP_CHAT_URL=https://wss.lke.tencentcloud.com/adp/v2/chat
ADP_APPKEY_RIDER_ADVOCATE=
ADP_APPKEY_DRIVER_ADVOCATE=
ADP_APPKEY_JUDGE=

# Fallback if ADP quota runs out
DEEPSEEK_API_KEY=

# Use saved/mocked LLM responses instead of live calls (saves tokens during UI work)
USE_MOCK_LLM=true
